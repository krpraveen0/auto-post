        <mxCell id="title" value="One agent release = six configuration surfaces" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#0B2545;" vertex="1" parent="1"><mxGeometry x="55" y="15" width="900" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Behavior changes when any surface changes—even if the prompt stays the same." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="55" y="55" width="900" height="30" as="geometry"/></mxCell>
