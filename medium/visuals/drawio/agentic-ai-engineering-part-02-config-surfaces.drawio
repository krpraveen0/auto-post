        <mxCell id="version" value="CONFIG VERSION 0.2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#A5B4FC;fontColor=#3730A3;fontFamily=Arial;fontSize=13;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="1280" y="115" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="prompt" value="&lt;b&gt;1&amp;nbsp; Prompt Policy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;role • success • uncertainty&lt;br&gt;judgment, not permissions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=16;align=left;spacingLeft=18;arcSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="tools" value="&lt;b&gt;2&amp;nbsp; Tool Action Space&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;allow-list • schemas • side effects&lt;br&gt;what the agent can actually do&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=16;align=left;spacingLeft=18;arcSize=14;" vertex="1" parent="1"><mxGeometry x="605" y="175" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="model" value="&lt;b&gt;3&amp;nbsp; Model Envelope&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;snapshot • settings • fallback&lt;br&gt;the evaluated behavior range&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=16;align=left;spacingLeft=18;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="175" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="retrieval" value="&lt;b&gt;4&amp;nbsp; Retrieval Evidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;collections • filters • no-result policy&lt;br&gt;which facts enter the context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=16;align=left;spacingLeft=18;arcSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="guardrails" value="&lt;b&gt;5&amp;nbsp; Runtime Guardrails&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;approvals • budgets • stop rules&lt;br&gt;policy enforced outside the model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=16;align=left;spacingLeft=18;arcSize=14;" vertex="1" parent="1"><mxGeometry x="605" y="640" width="390" height="140" as="geometry"/></mxCell>
