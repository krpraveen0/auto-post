<mxfile host="app.diagrams.net"><diagram name="State machine"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A bounded loop is a state machine, not a promise" style="text;html=1;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="900" height="50" as="geometry"/></mxCell><mxCell id="run" value="RUNNING&#xa;consume one step&#xa;authorize proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=18;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="250" height="130" as="geometry"/></mxCell><mxCell id="wait" value="WAITING&#xa;matching approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontSize=18;" vertex="1" parent="1"><mxGeometry x="485" y="180" width="250" height="130" as="geometry"/></mxCell><mxCell id="exec" value="EXECUTING&#xa;stable operation ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="485" y="420" width="250" height="130" as="geometry"/></mxCell><mxCell id="stop" value="STOPPED&#xa;denied or no budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="145" width="250" height="120" as="geometry"/></mxCell><mxCell id="fail" value="FAILED&#xa;failure budget exhausted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="375" width="250" height="120" as="geometry"/></mxCell><mxCell id="success" value="SUCCEEDED&#xa;goal independently verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="250" height="120" as="geometry"/></mxCell><mxCell id="e1" value="approval required" edge="1" parent="1" source="run" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="approved" edge="1" parent="1" source="wait" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="allowed" edge="1" parent="1" source="run" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="policy/budget" edge="1" parent="1" source="run" target="stop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="failures exhausted" edge="1" parent="1" source="exec" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="verified" edge="1" parent="1" source="exec" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="retry same ID" edge="1" parent="1" source="exec" target="run"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
